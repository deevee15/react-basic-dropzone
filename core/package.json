{
   "name": "react-basic-dropzone",
   "private": false,
   "scripts": {
      "build": "vite build",
      "test": "vitest run",
      "test:watch": "vitest",
      "prepublishOnly": "npm run build"
   },
   "description": "Lightweight React dropzone component with file validation, upload progress, and drag-and-drop support",
   "keywords": [
      "react",
      "dropzone",
      "file-upload",
      "drag-and-drop",
      "typescript"
   ],
   "author": "Danil Vikulov <vikulovd15@gmail.com>",
   "license": "MIT",
   "version": "1.0.0",
   "repository": {
      "type": "git",
      "url": "https://github.com/deevee15/react-basic-dropzone"
   },
   "homepage": "https://github.com/deevee15/react-basic-dropzone#readme",
   "bugs": {
      "url": "https://github.com/deevee15/react-basic-dropzone/issues"
   },
   "type": "module",
   "main": "./dist/index.cjs.js",
   "module": "./dist/index.es.js",
   "types": "./dist/index.d.ts",
   "exports": {
      ".": {
         "import": "./dist/index.es.js",
         "require": "./dist/index.cjs.js",
         "types": "./dist/index.d.ts"
      }
   },
   "files": [
      "dist"
   ],
   "peerDependencies": {
      "react": "^18.0.0 || ^19.0.0",
      "react-dom": "^18.0.0 || ^19.0.0"
   },
   "devDependencies": {
      "@testing-library/jest-dom": "^6.9.1",
      "@testing-library/react": "^16.0.0",
      "@testing-library/user-event": "^14.6.1",
      "@types/react": "^19.2.14",
      "@vitejs/plugin-react": "^5.0.0",
      "jsdom": "^29.1.1",
      "tailwindcss": "^4.0.0",
      "typescript": "^5.0.0",
      "vite": "^7.0.0",
      "vite-plugin-dts": "^5.0.0",
      "vitest": "^3.0.0"
   },
   "browserslist": {
      "development": [
         "last 1 chrome version",
         "last 1 firefox version",
         "last 1 safari version"
      ],
      "production": [
         ">0.2%",
         "not dead",
         "not op_mini all"
      ]
   }
}
