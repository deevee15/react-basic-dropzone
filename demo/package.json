      "eslint-plugin-security": "^3.0.1",
      "express": "^5.1.0",
      "express-rate-limit": "^8.2.1",
      "multiformats": "^13.4.1",
      "normalize.css": "^8.0.1",
      "npx": "^10.2.2",
      "path": "^0.12.7",
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "react-router": "^6.22.3",
